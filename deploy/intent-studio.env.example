# Intent Studio's production configuration: every setting intent-server reads, as environment
# variables. Copy to /etc/intent-studio/intent-studio.env (owner root, mode 0600: systemd reads
# it as root for the unit and for `systemd-run` one-off commands; nothing running as `intent`
# may read the file at all) and replace every __PLACEHOLDER__. `intent-server check-config`
# reports every problem at once without starting; scripts/test-deploy.sh runs it over this
# file on every check.
#
# Values with `$` (the password hash) stay in single quotes: systemd and a shell both read
# them literally.

# --- Required -------------------------------------------------------------------------------

INTENT_PROFILE=production
# Only the reverse proxy talks to the server: keep it on loopback.
INTENT_BIND=127.0.0.1:59400
# The database role and password (see docs/OPERATOR_GUIDE.md, "First run").
INTENT_DATABASE_URL='postgres://intent:__DB_PASSWORD__@127.0.0.1:5432/intent'
# `intent-server hash-password` prints it; paste it whole, in single quotes.
INTENT_OPERATOR_PASSWORD_HASH='__OPERATOR_PASSWORD_HASH__'
# Lead notifications. Until the e-mail adapter arrives (I3) the provider is an HTTP webhook
# that receives one JSON notification per lead; it speaks plain HTTP, so keep it on loopback
# or a private network — production refuses an http URL anywhere else. The lead is in the
# inbox whether or not this answers (invariant 5).
INTENT_NOTIFY_PROVIDER=webhook
INTENT_NOTIFY_WEBHOOK_URL=http://127.0.0.1:59480/v1/notify

# --- Behind the reverse proxy ---------------------------------------------------------------

# The proxy on this host: only its X-Forwarded-For is believed (D-019).
INTENT_TRUSTED_PROXIES=127.0.0.1,::1
# The session cookie is Secure (`__Host-` prefixed); the proxy terminates HTTPS. `false` is
# for development only — production refuses it.
INTENT_COOKIE_SECURE=true

# --- Files ----------------------------------------------------------------------------------

# The built workspace app (apps/workspace/build), served at /workspace.
INTENT_WORKSPACE_DIR=/opt/intent-studio/workspace
# The content-addressed store for assets and reference snapshots (D-016, D-061); back it up
# with the database. Without it, uploads and snapshots answer 503 and everything else works.
INTENT_STORE_DIR=/var/lib/intent-studio/store
# Crash-durable runtime state — the sign-out retry journal (NEW-1). Independent of the
# store; an unreadable or oversized journal refuses the boot rather than losing owed
# deletes. Default: ./intent-state under the working directory — set it absolute.
INTENT_STATE_DIR=/var/lib/intent-studio/state
# The asset worker (D-062). Defaults to `intent-worker` beside intent-server.
INTENT_WORKER_BIN=/opt/intent-studio/bin/intent-worker

# --- Optional (the defaults are the decided values; change one only with a reason) ----------

# A bearer token for /metrics (16+ characters); without it only the host itself may read it.
#INTENT_METRICS_TOKEN='__METRICS_TOKEN__'
#INTENT_LOG=info,sqlx=warn
#INTENT_LOG_FORMAT=json
#INTENT_DB_MAX_CONNECTIONS=16
#INTENT_NOTIFY_DB_CONNECTIONS=8
#INTENT_MAX_CONNECTIONS=1024
#INTENT_REQUEST_TIMEOUT_MS=5000
#INTENT_INTAKE_DEADLINE_MS=3000
#INTENT_SESSION_TTL_SECS=43200
#INTENT_SESSION_IDLE_SECS=1800
#INTENT_WORKER_TIMEOUT_MS=10000
#INTENT_WORKER_CONCURRENCY=2
#INTENT_DRAIN_DELAY_MS=2000
#INTENT_SHUTDOWN_GRACE_MS=10000
