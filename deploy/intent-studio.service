# systemd unit for intent-server. Install: docs/OPERATOR_GUIDE.md, "Install". Checked on every
# CI run by scripts/test-deploy.sh (`systemd-analyze verify`).
[Unit]
Description=Intent Studio (intent-server)
Documentation=https://github.com/akira-shirase-oss/intent-studio/blob/main/docs/OPERATOR_GUIDE.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=intent
Group=intent
EnvironmentFile=/etc/intent-studio/intent-studio.env
ExecStart=/opt/intent-studio/bin/intent-server serve
# SIGTERM starts the drain: readiness goes false, the listener stops after the drain delay,
# in-flight requests get the shutdown grace (2 s + 10 s by default). Leave room beyond it.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=2

# Connections (1,024) plus pools and the store.
LimitNOFILE=8192

# /var/lib/intent-studio, created and owned by systemd: the store lives in it.
StateDirectory=intent-studio
StateDirectoryMode=0750

# Sandboxing: the server writes only its state directory; it and the worker it starts see no
# home directories, no other users' temporary files, no kernel tunables.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# The browser jail (docs/BROWSER-CONFINEMENT.md) builds its own confinement: a user
# namespace so the mounts are allowed unprivileged, then net/mount/ipc/pid around
# the page under test. Permit exactly those five — every other namespace type
# (uts, cgroup, time) stays refused.
RestrictNamespaces=user ipc mnt net pid
# The binaries run under the AppArmor profile granting `userns` (deploy/
# apparmor.d/intent-jail) — Ubuntu 24.04 refuses unprivileged user namespaces
# to unprofiled programs, and the jail is all user namespaces. A missing
# profile fails this unit at start: fail closed, no unconfined browser.
AppArmorProfile=intent-jail
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
# The worker lowers its own limits with setrlimit and installs its own seccomp filter before
# it reads a byte; the server calls prctl(PR_SET_DUMPABLE) at start. @system-service carries
# all three; naming prctl and seccomp keeps the allowance if the group ever narrows.
SystemCallFilter=@system-service prctl seccomp
SystemCallFilter=~@privileged
# Back after the deny group: the syscalls the jail needs that @privileged
# swallows — namespace creation (unshare/setns), the mount/umount the jail
# root is built from, and pivot_root itself.
SystemCallFilter=unshare setns mount umount umount2 pivot_root
UMask=0077

[Install]
WantedBy=multi-user.target
